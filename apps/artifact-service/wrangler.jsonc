{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lordebuilds-artifacts-share",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-08-16",
  "vars": {
    "ALLOWED_EXPIRY_SECONDS": "900,1800,3600,86400,604800",
    "MAX_ARTIFACT_BYTES": "26214400",
    "MAX_EXPIRY_SECONDS": "604800",
    "HUMAN_AUTH_MODE": "artifactpass"
  },
  "secrets": {
    "required": [
      "GOOGLE_OAUTH_CLIENT_SECRET",
      "GITHUB_OAUTH_CLIENT_SECRET"
    ]
  },
  "d1_databases": [
    {
      "binding": "ARTIFACT_DB",
      "database_name": "lordebuilds-artifacts-share",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "lordebuilds-artifacts-share"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "assets": {
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": ["/health", "/auth/*", "/upload", "/upload/*", "/connect/*", "/api/*", "/a/*"]
  }
}
