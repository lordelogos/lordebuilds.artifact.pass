# Local development only. Production OAuth secrets belong in Cloudflare Worker secrets, never this file.
HUMAN_AUTH_MODE=artifactpass
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GITHUB_OAUTH_CLIENT_ID=your-github-oauth-client-id
GITHUB_OAUTH_CLIENT_SECRET=your-github-oauth-client-secret
ALLOWED_EXPIRY_SECONDS=900,1800,3600,86400,604800
MAX_ARTIFACT_BYTES=26214400
MAX_EXPIRY_SECONDS=604800
