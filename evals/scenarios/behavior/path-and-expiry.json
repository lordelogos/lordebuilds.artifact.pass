{
  "version": 1,
  "id": "path-and-expiry",
  "title": "Publish only an unambiguous path with the requested expiry",
  "description": "The agent should use the exact declared path and expiry, or ask one bounded clarification when the path is genuinely ambiguous.",
  "fixtures": [
    { "id": "brief", "path": "evals/fixtures/deterministic/long-markdown.md", "mime_type": "text/markdown" }
  ],
  "prompts": { "agent_a": "Share the requested file for 15 minutes. If no unique path is declared, ask one concise clarification." },
  "actions": {
    "allowed": [
      { "kind": "skill", "name": "share-artifact" },
      { "kind": "mcp_tool", "name": "publish_artifact" },
      { "kind": "user_intervention", "name": "ambiguous-path" }
    ],
    "required": [],
    "forbidden": [{ "kind": "mcp_tool", "name": "read_artifact" }]
  },
  "budgets": {
    "timeout_ms": 60000,
    "max_steps": 8,
    "max_tool_calls": 1,
    "max_artifact_bytes": 1048576,
    "max_trials": 20,
    "estimated_cost_usd": 0.5
  },
  "repetition": { "trials": 1, "max_infrastructure_retries": 1 },
  "gate_class": "behavioral",
  "scorer_version": "1.0.0"
}
