{
  "name": "artifactpass",
  "version": "0.1.0-rc.4",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "demo": "pnpm --dir apps/artifact-service demo",
    "dev": "pnpm --dir apps/artifact-service dev",
    "eval:build": "pnpm plugin:build && pnpm --dir packages/eval-runner build",
    "eval:deterministic": "pnpm eval:build && node packages/eval-runner/dist/deterministic-cli.cjs",
    "eval:host-probe": "pnpm --dir packages/eval-runner build && node packages/eval-runner/dist/trace-probe.mjs",
    "eval:matrix": "pnpm --dir packages/eval-runner build && node packages/eval-runner/dist/matrix-cli.mjs",
    "eval:baseline": "pnpm eval:build && node packages/eval-runner/dist/baseline-cli.cjs",
    "eval:cohort": "pnpm eval:build && node packages/eval-runner/dist/cohort-cli.cjs",
    "eval:release": "pnpm --dir packages/eval-runner build && node packages/eval-runner/dist/release-cli.cjs",
    "eval:release:fresh": "pnpm eval:build && node scripts/run-release-evals.mjs",
    "eval:smoke": "pnpm eval:build && node packages/eval-runner/dist/smoke-cli.cjs",
    "lint": "oxlint --deny-warnings .",
    "plugin:build": "pnpm --dir packages/agent-bridge build && node scripts/build-plugin.mjs",
    "plugin:check": "node scripts/build-plugin.mjs --check",
    "release:packages": "node scripts/inspect-release-packages.mjs",
    "release:build": "node scripts/build-release-artifacts.mjs",
    "release:check": "pnpm security:secrets && pnpm check && pnpm security:licenses && pnpm security:audit && pnpm release:packages",
    "security:audit": "pnpm audit --prod --audit-level high",
    "security:licenses": "node scripts/audit-licenses.mjs",
    "security:secrets": "node scripts/scan-secrets.mjs",
    "test": "vitest run --config vitest.workspace.ts",
    "test:browser": "playwright test",
    "test:browser:live": "playwright test tests/e2e/browser-share.spec.ts tests/e2e/end-to-end-handoff.spec.ts",
    "test:local-demo": "vitest run --config tests/local-demo.vitest.config.ts",
    "test:network": "vitest run --config tests/network.vitest.config.ts",
    "test:network:live": "node scripts/test-network-demo.mjs",
    "test:agent-contract": "pnpm --dir packages/agent-bridge build && pnpm --dir packages/agent-bridge exec vitest run test/stdio-smoke.test.ts && vitest run --config tests/vitest.config.ts tests/agent-portability.test.ts",
    "test:agent-hosts": "pnpm plugin:build && node scripts/test-agent-hosts.mjs",
    "test:packed-install": "pnpm --dir packages/setup-cli build && node scripts/test-packed-install.mjs",
    "test:protocol": "pnpm --dir packages/artifact-protocol test",
    "test:worker": "pnpm --dir apps/artifact-service test",
    "tunnel": "node scripts/network-demo.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "types:worker": "pnpm --dir apps/artifact-service types:worker",
    "check": "pnpm --dir packages/agent-bridge build && pnpm plugin:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@playwright/test": "^1.62.1",
    "esbuild": "^0.28.1",
    "oxlint": "^1.78.0",
    "vitest": "^4.1.10"
  }
}
