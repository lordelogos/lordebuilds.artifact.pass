{
  "name": "lordebuilds.artifacts.share",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --dir apps/artifact-service dev",
    "lint": "oxlint --deny-warnings .",
    "test": "vitest run --config vitest.workspace.ts",
    "test:protocol": "pnpm --dir packages/artifact-protocol test",
    "test:worker": "pnpm --dir apps/artifact-service test",
    "typecheck": "pnpm -r --if-present typecheck",
    "types:worker": "pnpm --dir apps/artifact-service types:worker",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "oxlint": "^1.78.0",
    "vitest": "^4.1.10"
  }
}
