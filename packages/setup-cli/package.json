{
  "name": "artifactpass",
  "version": "0.1.0-rc.9",
  "description": "Install and connect ArtifactPass for compatible AI agent systems.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lordelogos/lordebuilds.artifact.pass.git"
  },
  "type": "module",
  "bin": {
    "artifactpass": "dist/cli.mjs"
  },
  "files": ["dist"],
  "scripts": {
    "build": "pnpm --dir ../../apps/artifact-service build && node ../../scripts/build-setup-package.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "wrangler": "4.123.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.14",
    "agent-bridge": "workspace:*",
    "artifact-service": "workspace:*",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
